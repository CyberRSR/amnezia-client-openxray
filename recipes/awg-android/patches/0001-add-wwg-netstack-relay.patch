+	dns, err := parseNetstackAddresses(dnsServers)
+	if err != nil {
+		logger.Errorf("Parse DNS addresses: %v", err)
+		return -1
+	}
+	if mtu < 576 || mtu > 65535 {
+		logger.Errorf("Invalid netstack MTU: %d", mtu)
+		return -1
+	}
+
+	tunDevice, tnet, err := netstack.CreateNetTUN(addresses, dns, int(mtu))
+	if err != nil {
+		logger.Errorf("CreateNetTUN: %v", err)
+		return -1
+	}
+	wgDevice := device.NewDevice(tunDevice, conn.NewStdNetBind(), logger)
+	if err = wgDevice.IpcSet(settings); err != nil {
+		logger.Errorf("IpcSet: %v", err)
+		wgDevice.Close()
+		return -1
+	}
+	wgDevice.DisableSomeRoamingForBrokenMobileSemantics()
+	if err = wgDevice.Up(); err != nil {
+		logger.Errorf("Unable to bring up netstack device: %v", err)
+		wgDevice.Close()
